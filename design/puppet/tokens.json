      "translateY": [
        24,
        0
      ],
      "opacity": [
        0,
        1
      ],
      "duration": 420,
      "delay": 120,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "teamReveal": {
      "fill": [
        "team.hidden",
        "team.*"
      ],
      "duration": 600,
      "delay": 300,
      "easing": "ease-out"
    },
    "nightToDay": {
      "duration": 1800,
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "dayToNight": {
      "duration": 1200,
      "easing": "cubic-bezier(.4,0,1,1)"
    },
    "deathDrop": {
      "rotate": [
        0,
        12
      ],
      "translateY": [
        0,
        40
      ],
      "opacity": [
        1,
        0
      ],
      "duration": 700,
      "easing": "cubic-bezier(.55,0,1,.45)"
    },
    "winnersRise": {
      "translateY": [
        30,
        0
      ],
      "duration": 500,
      "stagger": 80,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "press": {
      "scale": [
        1,
        0.97
      ],
      "durationIn": 90,
      "durationOut": 160
