        158
      ],
      "scaleY": [
        1,
        0.55
      ],
      "duration": 300,
      "repeat": 3,
      "every": 4000
    },
    "drum": {
      "pivot": [
        196,
        262
      ],
      "scale": [
        1,
        1.04
      ],
      "duration": 180,
      "easing": "cubic-bezier(0,0,.2,1)"
    }
