  "transitions": {
    "cardFlipOut": {
      "rotateY": [
        0,
        90
      ],
      "duration": 220,
      "easing": "cubic-bezier(.4,0,1,1)"
    },
    "cardFlipIn": {
      "rotateY": [
        90,
        0
      ],
      "duration": 320,
      "easing": "cubic-bezier(0,0,.2,1)"
    },
